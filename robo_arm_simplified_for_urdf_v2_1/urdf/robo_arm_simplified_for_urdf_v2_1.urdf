        <axis xyz="0 0 1" />
        <parent link="link_3" />
        <child link="mate_connector_3" />
    </joint>
    <joint name="mate_connector_4" type="fixed">
        <origin xyz="-1.21353e-15 -0.0249798 0.24" rpy="1.5708 -0 0" />
        <axis xyz="0 0 1" />
        <parent link="link_2" />
        <child link="mate_connector_4" />
    </joint>
    <joint name="revolute_1" type="revolute">
        <!-- yaw = -90 deg: corrects rest pose to match the physical home
             (chosen for wiring constraints, ROBOT_ARM_HANDOFF.md §3) - the
             CAD export's zero pose did not match it. See §7 test 4 notes. -->
        <origin xyz="-1.49235e-17 7.11621e-24 0.1037" rpy="0 0 -1.570796" />
        <axis xyz="-0 -0 -1" />
        <parent link="link_0" />
        <child link="link_1" />
        <!-- Real range is -135deg to +210deg (wiring constraint). This has to be
             a proper "revolute" joint with a limit tag, not "continuous" -
             continuous joints plan/interpolate in a wraparound space regardless
             of joint_limits.yaml, which breaks Execute on any trajectory whose
             values fall outside a plain +-180deg window. -->
        <limit effort="1" velocity="1" lower="-2.356194" upper="3.665191" />
    </joint>
    <joint name="revolute_2" type="revolute">
        <origin xyz="7.79295e-18 0.0640254 0.0457749" rpy="0 -0 0" />
        <axis xyz="-0 -1 -0" />
        <parent link="link_1" />
        <child link="link_2" />
        <limit effort="1" velocity="1" lower="-1.91986" upper="1.91986" />
    </joint>
    <joint name="revolute_3" type="revolute">
        <origin xyz="3.93793e-17 -0.0249798 0.24" rpy="0 -0 0" />
        <axis xyz="-0 1 -0" />
        <parent link="link_2" />
        <child link="link_3" />
        <!-- Real range is -45deg to +405deg - see revolute_1 above for why this
             has to be "revolute" with a limit tag, not "continuous". -->
        <limit effort="1" velocity="1" lower="-0.785398" upper="7.068583" />
    </joint>
    <joint name="revolute_4" type="revolute">
        <!-- extra -90 deg about the local roll axis (on top of the existing
             90 deg from CAD): corrects rest pose to match the physical home,
             same reasoning as revolute_1 above. -->
        <origin xyz="3.9942e-16 -0.0404996 0.0353704" rpy="1.570796 0 -1.570796" />
        <axis xyz="-0 -1 -0" />
        <parent link="link_3" />
        <child link="link_4" />
        <!-- Real range is +-180deg - see revolute_1 above for why this has to
             be "revolute" with a limit tag, not "continuous". -->
        <limit effort="1" velocity="1" lower="-3.141593" upper="3.141593" />
    </joint>
    <joint name="revolute_5" type="revolute">
        <origin xyz="2.6168e-05 0.1245 0.0171007" rpy="-8.03191e-32 3.96004e-63 9.86076e-32" />
        <axis xyz="-0 -0 1" />
        <parent link="link_4" />
        <child link="link_5" />
        <limit effort="1" velocity="1" lower="-1.5708" upper="1.5708" />
    </joint>
    <joint name="revolute_6" type="revolute">
        <origin xyz="1.12164e-16 0.0201 -0.0171007" rpy="-7.61227e-32 1.06671e-76 2.8026e-45" />
        <axis xyz="-0 -1 -0" />
        <parent link="link_5" />
        <child link="link_6" />
        <!-- Real range is +-180deg roll - see revolute_1 above for why this has
             to be "revolute" with a limit tag, not "continuous". -->
        <limit effort="1" velocity="1" lower="-3.141593" upper="3.141593" />
    </joint>
</robot>